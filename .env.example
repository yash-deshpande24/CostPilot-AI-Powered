# Copy to .env and fill in. Never commit .env.
JWT_SECRET=change-me-to-a-long-random-string
MONGO_URI=mongodb://mongo:27017/costpilot

# mock = sample data and fake AWS resources (no AWS account needed)
# aws  = real Cost Explorer data and real resource scans (read-only)
COST_SOURCE=mock
CACHE_HOURS=24
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Week 3: leave ANTHROPIC_API_KEY empty to get free sample answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Max AI requests per user per day (explain, rank and chat each count as one)
AI_DAILY_LIMIT=30
# Optional: set both to see an estimated daily AI cost. USD per million tokens, from the Anthropic pricing page.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=

# Demo only: shows the reset link on the page because there is no email service yet.
# Never set to true on a real server.
SHOW_RESET_LINK=true
APP_URL=http://localhost:8080

# Week 6: automatic pull requests.
# Leave GITHUB_TOKEN empty to stay in preview (mock) mode: the app builds the pull request
# and shows it, but sends nothing. Use a fine-grained token with Contents + Pull requests
# read/write on this one repository only. Never commit the real token.
GITHUB_TOKEN=
GITHUB_REPO=yash-deshpande24/CostPilot-AI-Powered
GITHUB_BASE_BRANCH=main
PR_MODE=
PR_DIR=costpilot-gitops/remediations
PR_DAILY_LIMIT=10