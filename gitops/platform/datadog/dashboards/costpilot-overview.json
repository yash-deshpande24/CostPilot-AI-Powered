{
  "title": "CostPilot: API health and AI usage",
  "description": "Created from gitops/platform/datadog. Metric names come from the /metrics page of the API.",
  "layout_type": "ordered",
  "widgets": [
    {
      "definition": {
        "type": "timeseries",
        "title": "Requests per second",
        "requests": [{ "q": "sum:costpilot_http_requests_total{*}.as_rate()", "display_type": "bars" }]
      },
      "layout": { "x": 0, "y": 0, "width": 4, "height": 3 }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Error rate, last 15 min (%)",
        "requests": [{ "q": "sum:costpilot_http_requests_total{status_class:5xx}.as_rate() / sum:costpilot_http_requests_total{*}.as_rate() * 100", "aggregator": "avg" }],
        "precision": 2
      },
      "layout": { "x": 4, "y": 0, "width": 4, "height": 3 }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Average request time (seconds)",
        "requests": [{ "q": "sum:costpilot_http_request_duration_seconds_sum{*}.as_rate() / sum:costpilot_http_request_duration_seconds_count{*}.as_rate()", "display_type": "line" }]
      },
      "layout": { "x": 8, "y": 0, "width": 4, "height": 3 }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Claude tokens per minute (cost driver)",
        "requests": [{ "q": "sum:costpilot_ai_tokens_total{*} by {direction}.as_rate()", "display_type": "area" }]
      },
      "layout": { "x": 0, "y": 3, "width": 6, "height": 3 }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Claude calls by result",
        "requests": [{ "q": "sum:costpilot_ai_calls_total{*} by {result}.as_rate()", "display_type": "bars" }]
      },
      "layout": { "x": 6, "y": 3, "width": 6, "height": 3 }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Pod restarts (backend and scan job)",
        "requests": [{ "q": "sum:kubernetes.containers.restarts{kube_namespace:costpilot} by {kube_container_name}.as_count()", "display_type": "bars" }]
      },
      "layout": { "x": 0, "y": 6, "width": 6, "height": 3 }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "CPU and memory by pod",
        "requests": [
          { "q": "sum:kubernetes.cpu.usage.total{kube_namespace:costpilot} by {pod_name}", "display_type": "line" },
          { "q": "sum:kubernetes.memory.usage{kube_namespace:costpilot} by {pod_name}", "display_type": "line" }
        ]
      },
      "layout": { "x": 6, "y": 6, "width": 6, "height": 3 }
    }
  ]
}
