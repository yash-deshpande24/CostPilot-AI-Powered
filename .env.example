# Copy to .env and fill in. Never commit .env.
JWT_SECRET=change-me-to-a-long-random-string
MONGO_URI=mongodb://mongo:27017/costpilot

# mock = sample data and fake AWS resources (no AWS account needed)
# aws  = real Cost Explorer data and real resource scans (read-only)
COST_SOURCE=mock
CACHE_HOURS=24
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Week 3: leave ANTHROPIC_API_KEY empty to get free sample answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Max AI requests per user per day (explain, rank and chat each count as one)
AI_DAILY_LIMIT=30
# Optional: set both to see an estimated daily AI cost. USD per million tokens, from the Anthropic pricing page.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
